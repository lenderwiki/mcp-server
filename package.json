  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iainbwilliams-cpu/lenderwiki-mcp-server.git"
  },
  "homepage": "https://lenderwiki.com",
  "bugs": {
    "url": "https://github.com/iainbwilliams-cpu/lenderwiki-mcp-server/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
